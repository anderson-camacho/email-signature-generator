---
import Layout from "../../components/Layout.astro";
import { dictionary, locales, type Locale } from "../../i18n/dictionaries";

type StaticPageKey =
  | "privacy"
  | "email-installation-guide"
  | "faq"
  | "support-open-source"
  | "donations";

type BasicContent = {
  title: string;
  paragraphs: string[];
};

type GuideSection = {
  title: string;
  audience: string;
  steps: string[];
  notes: string[];
  resourceLabel: string;
  resourceUrl: string;
};

type InstallationGuide = {
  title: string;
  intro: string;
  checklistTitle: string;
  checklist: string[];
  sections: GuideSection[];
  managedTitle: string;
  managedCopy: string[];
};

export function getStaticPaths() {
  const pages: StaticPageKey[] = [
    "privacy",
    "email-installation-guide",
    "faq",
    "support-open-source",
    "donations",
  ];

  return locales.flatMap((locale) =>
    pages.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    })),
  );
}

const { locale, page } = Astro.props as { locale: Locale; page: StaticPageKey };
const t = dictionary(locale);

