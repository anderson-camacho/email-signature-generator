                "If you have more than one account, select the correct account before creating the signature.",
                "Choose Add signature, give it a name, and paste the signature into the editor.",
                "Choose whether the signature should be applied to new emails and to replies or forwards.",
                "Save your changes.",
              ],
              notes: [
                "In Microsoft 365, one user may need different signatures per account or per message type.",
                "If your organization uses centralized signature management, IT may overwrite the user-level signature.",
              ],
              resourceLabel: "Open the official Outlook web guide",
              resourceUrl:
                "https://support.microsoft.com/en-us/outlook/mail/how-to-add-and-change-an-email-signature-in-outlook",
            },
            {
              title: "Classic Outlook on Windows",
              audience:
                "For business computers that still use the classic desktop version of Outlook on Windows.",
              steps: [
                "Open a new email message.",
                "On the Message menu, go to Signature > Signatures.",
                "Under Select signature to edit, choose New and give the signature a name.",
                "Paste the signature into the Edit signature box.",
                "Under Choose default signature, select the account and define whether it applies to new messages and to replies or forwards.",
                "Choose OK to save.",
              ],
              notes: [
                "The new signature may not insert itself into the message you already had open, so you may need to add it manually from Signature.",
                "Classic Outlook usually preserves pasted signatures better than rebuilding them manually.",
              ],
              resourceLabel: "Open the official classic Outlook guide",
              resourceUrl:
                "https://support.microsoft.com/en-us/outlook/mail/how-to-add-and-change-an-email-signature-in-outlook",
            },
            {
              title: "Apple Mail on Mac and iCloud Mail",
              audience:
                "For users who send email from the macOS Mail app or from iCloud Mail on the web.",
              steps: [
                "In Mail for Mac, open the app and go to Mail > Settings > Signatures.",
                "Select the correct account, create a new signature with the plus button, and paste the content into the preview area.",
                "If you created it under All Signatures, drag it to the account where you want to use it.",
                "If you use iCloud Mail on the web, go to icloud.com/mail, open Settings, and then Composing.",
                "Enable Add a signature and type or paste the signature there.",
                "Send one test from Mail on Mac and another from iCloud web if you use both.",
              ],
              notes: [
                "Apple Mail lets you decide whether the signature appears above or below quoted text in replies.",
                "If iCloud web changes the appearance, use a simpler version with fewer visual blocks.",
              ],
              resourceLabel: "Open the official Apple guide",
              resourceUrl:
                "https://support.apple.com/guide/mail/edit-text-and-email-signatures-mail11943/mac",
            },
            {
              title: "Thunderbird",
              audience:
                "For teams or personal accounts that use Thunderbird as the desktop mail client.",
              steps: [
                "Open Thunderbird and go to Account Settings.",
                "Select the mail account where you want to use the signature.",
                "Find the signature field in that account configuration.",
                "Paste the signature if you will use a direct text or HTML signature.",
                "If your company manages an external HTML signature, configure Thunderbird to use an HTML signature file instead.",
                "Save and send a test message to verify replies and forwards.",
              ],
              notes: [
                "Thunderbird configures signatures per account, so repeat the process if you manage multiple mailboxes.",
                "If you use images, confirm that they do not appear as separate attachments.",
              ],
              resourceLabel: "Open the official Thunderbird guide",
              resourceUrl: "https://support.mozilla.org/en-US/kb/signatures",
            },
          ],
          managedTitle: "If your company centrally manages signatures",
          managedCopy: [
            "Some organizations do not allow users to edit signatures freely because signatures are managed from Microsoft 365, Google Workspace, or an external branding platform.",
            "If you cannot find the signature option, if your changes disappear, or if another signature replaces yours after sending, ask IT or marketing for the exact process or confirm whether signatures are enforced centrally.",
          ],
        }
      : buildLocalizedGuide(
          guideBasicsByLocale[locale] ?? guideBasicsByLocale.es,
        );

const isInstallationGuide = page === "email-installation-guide";
const basicPage = isInstallationGuide ? null : basicContents[page];
---

<Layout
  {locale}
  title={isInstallationGuide ? installationGuide.title : basicPage!.title}
>
  {
    isInstallationGuide ? (
      <article class="content-card guide-card">
        <h1>{installationGuide.title}</h1>
        <p class="guide-intro">{installationGuide.intro}</p>

        <section class="guide-checklist">
          <h2>{installationGuide.checklistTitle}</h2>
          <ol>
            {installationGuide.checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </section>

        <div class="guide-grid">
          {installationGuide.sections.map((section) => (
            <section class="guide-section">
              <div class="guide-section-head">
                <h2>{section.title}</h2>
                <p>{section.audience}</p>
              </div>

              <ol>
                {section.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>

              <ul class="guide-notes">
                {section.notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>

              <p class="guide-resource">
                <a href={section.resourceUrl} target="_blank" rel="noreferrer">
                  {section.resourceLabel}
                </a>
              </p>
            </section>
          ))}
        </div>

        <section class="guide-managed">
          <h2>{installationGuide.managedTitle}</h2>
          {installationGuide.managedCopy.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      </article>
    ) : (
      <article class="content-card">
        <h1>{basicPage!.title}</h1>
        {basicPage!.paragraphs.map((item) => (
          <p>{item}</p>
        ))}
      </article>
    )
  }
</Layout>
