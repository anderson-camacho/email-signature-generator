---
import Layout from "../../components/Layout.astro";
import Editor from "../../components/Editor.astro";
import { locales, type Locale } from "../../i18n/dictionaries";
import { breadcrumbJsonLd } from "../../seo/metadata";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const breadcrumbs = breadcrumbJsonLd(locale, [
  { name: "Home", path: "/" },
  { name: "Generator", path: "/generator/" },
]);
---

<Layout {locale} pageKind="generator" structuredData={breadcrumbs}>
  <Editor {locale} />
</Layout>
