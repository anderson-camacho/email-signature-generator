---
import Layout from "../../components/Layout.astro";
import Editor from "../../components/Editor.astro";
import { dictionary, locales, type Locale } from "../../i18n/dictionaries";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = dictionary(locale);
---
<Layout {locale}><section class="hero hero-compact"><h1>{t.title}</h1><p>{t.promise}</p><p class="notice">{t.privacy}</p></section><Editor {locale} /><section class="content-card"><h2>{t.savedFlowTitle}</h2><p>{t.savedFlowCopy}</p></section></Layout>
