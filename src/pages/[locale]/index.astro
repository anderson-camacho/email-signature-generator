---
import Layout from "../../components/Layout.astro";
import Editor from "../../components/Editor.astro";
import { dictionary, locales, type Locale } from "../../i18n/dictionaries";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = dictionary(locale);
---

<Layout {locale} pageKind="home">
  <section class="hero hero-compact">
    <h1>{t.title}</h1>
    <p>{t.promise}</p>
    <p class="notice">{t.privacy}</p>
  </section>

  <section class="content-card seo-intro" aria-labelledby="seo-benefits">
    <h2 id="seo-benefits">{t.mainFlowTitle}</h2>
    <p>{t.about}</p>
    <ul class="seo-list">
      <li>{t.directStart}</li>
      <li>{t.mainFlowCopy}</li>
      <li>{t.savedFlowCopy}</li>
      <li>{t.privacy}</li>
    </ul>
  </section>

  <Editor {locale} />

  <section class="content-card" id="saved-list">
    <h2>{t.savedFlowTitle}</h2>
    <p>{t.savedFlowCopy}</p>
  </section>
</Layout>
