---
import Layout from "../../components/Layout.astro";
import { dictionary, locales, type Locale } from "../../i18n/dictionaries";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = dictionary(locale);
---
<Layout {locale}><section class="hero"><h1>{t.title}</h1><p>{t.promise}</p><p class="notice">{t.privacy}</p><a class="button" href={`/${locale}/generator/`}>{t.generator}</a></section><section class="content-card"><h2>Open source and private by design</h2><p>{t.about}</p></section></Layout>
