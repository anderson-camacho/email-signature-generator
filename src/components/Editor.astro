      localImageNoFile: "Choose an image to adjust.",
      localImageReady: "Image ready and saved with this signature.",
      localImageInvalid: "Use JPG, PNG, WebP, or GIF.",
      localImageModalTitle: "Adjust image",
      localImageTarget: "Use as",
      localImagePhoto: "Photo",
      localImageLogo: "Logo",
      localImageMode: "Framing",
