      },
      exportTitle: "Your email signature",
      exportCopy:
        "Copy the signature below and paste it into your email client's signature settings.",
    };

const palettePresets = isSpanish
  ? [
      {
        id: "executive",
        name: "Ejecutivo",
        note: "Confianza, liderazgo y calma",
        primary: "#1e3a5f",
        secondary: "#2fbf9b",
      },
      {
        id: "growth",
        name: "Crecimiento",
        note: "Claridad, progreso y gestion simple",
        primary: "#214e48",
        secondary: "#57c4ad",
      },
      {
        id: "consulting",
        name: "Consultoria",
        note: "Estrategico y premium",
        primary: "#27364a",
        secondary: "#6db7c9",
      },
    ]
  : [
      {
        id: "executive",
        name: "Executive",
        note: "Trust, leadership, executive calm",
        primary: "#1e3a5f",
        secondary: "#2fbf9b",
      },
      {
        id: "growth",
        name: "Growth",
        note: "Clarity, progress, easy management",
        primary: "#214e48",
        secondary: "#57c4ad",
      },
      {
        id: "consulting",
        name: "Consulting",
        note: "Strategic and premium",
        primary: "#27364a",
        secondary: "#6db7c9",
      },
    ];

const localizedTemplateCopy = {
  minimal: {
    label: "Minimalista",
    cardTitle: "Ejecutiva",
    note: "Directa, limpia y corporativa",
  },
  "professional-logo": {
    label: "Logo profesional",
    cardTitle: "Marca central",
    note: "Enfocada en el logotipo",
  },
  "professional-photo": {
