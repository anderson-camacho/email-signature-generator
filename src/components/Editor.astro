      localImageContain: "Show full image",
      localImageZoom: "Zoom",
      localImageHorizontal: "Horizontal",
      localImageVertical: "Vertical",
      localImageFormat: "Format",
      localImageCancel: "Cancel",
      localImageApply: "Save image",
      colorsSection: "Colors and appearance",
      primaryColor: "Primary color",
      secondaryColor: "Secondary color",
