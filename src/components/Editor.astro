      mediaSection: "Photo and logo",
      localPreviewLabel: "Local logo or photo preview",
      localImageHelp:
        "Supports JPG, PNG, WebP, or GIF. It is optimized in your browser and saved with this signature.",
      localImageOpen: "Adjust image",
