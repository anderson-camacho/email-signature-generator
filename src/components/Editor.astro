      paletteHelp: "Quick palettes based on trust, clarity, and easy scanning.",
      socialSection: "Social media buttons",
      socialHelp:
        "Add as many buttons as needed, including multiple buttons for the same platform.",
      addSocial: "+ Add social network",
      socialEmpty:
        "No social buttons added. Your signature will not show this section.",
      socialPlatform: "Platform",
      socialUrl: "Public HTTPS URL",
      socialIconColor: "Icon color",
      socialOriginalColor: "Original platform color",
      socialPrimaryColor: "Selected primary color",
      remove: "Remove",
      previewEyebrow: "Live preview",
      previewDesktop: "Desktop",
      previewMobile: "Mobile",
      templatesEyebrow: "Templates",
      templatesTitle: "Pick a direction",
      supportCompact: "Not shown",
      photoUrlLabel: "Public photo URL HTTPS",
      logoUrlLabel: "Public logo URL HTTPS",
      fields: {
        fullName: "Full name",
        jobTitle: "Job title",
        company: "Company",
        department: "Area or department",
        email: "Email",
        phone: "Phone",
        website: "Website HTTPS",
        address: "Address",
        pronouns: "Pronouns",
        legalText: "Legal note",
      },
      examples: {
        fullName: "Alex Morgan",
        jobTitle: "Product Designer",
        company: "Example Studio",
        department: "Operations",
        email: "alex@example.com",
        phone: "+1 555 010 0000",
        website: "https://example.com",
        address: "123 Example Street",
        pronouns: "she/her",
        legalText: "Short legal note",
      },
      exportTitle: "Your email signature",
      exportCopy:
        "Copy the signature below and paste it into your email client's signature settings.",
    };

const ui = editorUiByLocale[locale] ?? editorUiByLocale.es;

const legacyPalettePresets = isSpanish
  ? [
      {
        id: "executive",
        name: "Ejecutivo",
        note: "Confianza, liderazgo y calma",
        primary: "#1e3a5f",
        secondary: "#2fbf9b",
      },
      {
        id: "growth",
        name: "Crecimiento",
        note: "Claridad, progreso y gestion simple",
        primary: "#214e48",
        secondary: "#57c4ad",
      },
      {
        id: "consulting",
        name: "Consultoria",
        note: "Estrategico y premium",
        primary: "#27364a",
        secondary: "#6db7c9",
      },
    ]
  : [
      {
        id: "executive",
        name: "Executive",
        note: "Trust, leadership, executive calm",
        primary: "#1e3a5f",
        secondary: "#2fbf9b",
      },
      {
        id: "growth",
        name: "Growth",
        note: "Clarity, progress, easy management",
        primary: "#214e48",
        secondary: "#57c4ad",
      },
      {
        id: "consulting",
        name: "Consulting",
        note: "Strategic and premium",
        primary: "#27364a",
        secondary: "#6db7c9",
      },
    ];

const palettePresets =
  palettePresetsByLocale[locale] ?? palettePresetsByLocale.es;

const legacyLocalizedTemplateCopy = {
  minimal: {
    label: "Minimalista",
    cardTitle: "Ejecutiva",
    note: "Directa, limpia y corporativa",
  },
  "professional-logo": {
    label: "Logo profesional",
    cardTitle: "Marca central",
    note: "Enfocada en el logotipo",
  },
  "professional-photo": {
    label: "Foto profesional",
    cardTitle: "Fundadora",
    note: "Humana, cercana y personal",
  },
  "administrative-area": {
    label: "Area administrativa",
    cardTitle: "Operaciones",
    note: "Funcional y orientada al equipo",
  },
  "scripted-intro": {
    label: "Intro manuscrita",
    cardTitle: "Entrada elegante",
    note: "Saludo manuscrito y perfil",
  },
  "bold-banner": {
    label: "Banner fuerte",
    cardTitle: "Impacto",
    note: "Composicion marcada con enfasis",
  },
  "promo-banner": {
    label: "Banner promocional",
    cardTitle: "CTA comercial",
    note: "Datos de contacto con franja promo",
  },
  "team-column": {
    label: "Columna de equipo",
    cardTitle: "Equipo",
    note: "Roster corporativo compacto",
  },
  "orb-profile": {
    label: "Perfil orbita",
    cardTitle: "Brillo atlas",
    note: "Insignia redonda con redes",
  },
  "scholar-strip": {
    label: "Franja academica",
    cardTitle: "Panel academico",
    note: "Perfil academico o consultivo",
  },
  "property-cta": {
    label: "CTA inmobiliario",
    cardTitle: "Inmobiliaria",
    note: "Tarjeta con llamada a la accion",
  },
  "social-stack": {
    label: "Stack social",
    cardTitle: "Creadora",
    note: "Rail vertical de redes",
  },
  "executive-card": {
    label: "Tarjeta ejecutiva",
    cardTitle: "Pizarra ejecutiva",
    note: "Retrato sobrio con CTA",
  },
  "legal-brief": {
    label: "Resumen legal",
    cardTitle: "Legal",
    note: "Estilo firme y formal",
  },
  "medical-profile": {
    label: "Perfil medico",
    cardTitle: "Salud",
    note: "Perfil claro para salud",
  },
  "holiday-postcard": {
    label: "Postal estacional",
    cardTitle: "Postal",
    note: "Calida y expresiva",
  },
} as const;

const legacyLocalizedTemplates = isSpanish
  ? templateCatalog.map((template) => {
      const copy =
        legacyLocalizedTemplateCopy[
          template.id as keyof typeof legacyLocalizedTemplateCopy
        ];
      return copy ? { ...template, ...copy } : template;
    })
  : templateCatalog;

void legacyUi;
void legacyPalettePresets;
void legacyLocalizedTemplates;

const localizedTemplateCopy =
  templateCardsByLocale[locale] ?? templateCardsByLocale.es;
const localizedTemplates = templateCatalog.map((template) => {
  const copy = localizedTemplateCopy[template.id];
  return copy ? { ...template, ...copy } : template;
});

const personalFields = [
  {
    name: "fullName",
    label: ui.fields.fullName,
    example: ui.examples.fullName,
  },
  {
    name: "jobTitle",
    label: ui.fields.jobTitle,
    example: ui.examples.jobTitle,
  },
  { name: "company", label: ui.fields.company, example: ui.examples.company },
  {
    name: "department",
    label: ui.fields.department,
    example: ui.examples.department,
  },
  { name: "email", label: ui.fields.email, example: ui.examples.email },
  { name: "phone", label: ui.fields.phone, example: ui.examples.phone },
  { name: "website", label: ui.fields.website, example: ui.examples.website },
  { name: "address", label: ui.fields.address, example: ui.examples.address },
  {
    name: "pronouns",
    label: ui.fields.pronouns,
    example: ui.examples.pronouns,
  },
  {
    name: "legalText",
    label: ui.fields.legalText,
    example: ui.examples.legalText,
  },
] as const;

const localizedDefaultConfig = {
  fullName: ui.examples.fullName,
  jobTitle: ui.examples.jobTitle,
  company: ui.examples.company,
  department: ui.examples.department,
  email: ui.examples.email,
  phone: ui.examples.phone,
  website: ui.examples.website,
  address: ui.examples.address,
  pronouns: ui.examples.pronouns,
  legalText: ui.examples.legalText,
};

const fieldValidationUi =
  fieldValidationUiByLocale[locale] ?? fieldValidationUiByLocale.es;
const fieldValidationKind = {
  fullName: "text",
  jobTitle: "text",
  company: "text",
  department: "text",
  email: "email",
  phone: "phone",
  website: "website",
  address: "text",
  pronouns: "text",
  legalText: "text",
} as const;
const fieldInputMode = {
  fullName: "text",
  jobTitle: "text",
  company: "text",
  department: "text",
  email: "email",
  phone: "tel",
  website: "url",
  address: "text",
  pronouns: "text",
  legalText: "text",
} as const;
const fieldMaxLength = {
  fullName: 90,
  jobTitle: 90,
  company: 110,
  department: 90,
  email: 254,
  phone: 24,
  website: 240,
  address: 180,
  pronouns: 60,
  legalText: 280,
} as const;
const fieldAutocomplete = {
  fullName: "name",
  jobTitle: "organization-title",
  company: "organization",
  department: undefined,
  email: "email",
  phone: "tel",
  website: "url",
  address: "street-address",
  pronouns: undefined,
  legalText: undefined,
} as const;
---

<section
  class="editor-shell"
  data-editor
  data-locale={locale}
  data-copied={t.copied}
  data-invalid={t.invalid}
  data-cleared={t.cleared}
  data-saved-to-library={t.savedToLibrary}
  data-library-empty={t.libraryEmpty}
  data-field-hidden={t.fieldHidden}
  data-template-fields-all={t.templateFieldSummaryAll}
  data-template-fields-hidden-prefix={t.templateFieldSummaryHidden}
  data-social-empty={ui.socialEmpty}
  data-social-platform-label={ui.socialPlatform}
  data-social-url-label={ui.socialUrl}
  data-social-icon-label={ui.socialIconColor}
  data-social-original-label={ui.socialOriginalColor}
  data-social-primary-label={ui.socialPrimaryColor}
  data-social-remove-label={ui.remove}
  data-export-title={ui.exportTitle}
  data-export-copy={ui.exportCopy}
  data-default-config={JSON.stringify(localizedDefaultConfig)}
  data-local-image-no-file={ui.localImageNoFile}
  data-local-image-ready={ui.localImageReady}
  data-local-image-invalid={ui.localImageInvalid}
  data-validation-email={fieldValidationUi.email}
  data-validation-phone={fieldValidationUi.phone}
  data-validation-website={fieldValidationUi.website}
  data-validation-text={fieldValidationUi.text}
>
  <div class="workspace-top">
    <div>
      <span class="eyebrow">{ui.workspaceEyebrow}</span>
      <h2>{t.form}</h2>
      <p class="panel-copy">{t.directStart}</p>
    </div>
    <div class="workspace-meta">
      <a class="workspace-action" href={`/${locale}/saved-signatures/`}
        >{t.savedPageAction}</a
      >
      <span class="autosave">{t.saved}</span>
      <span class="workspace-tag">{ui.workspaceTag}</span>
    </div>
  </div>

  <section class="editor" data-editor-layout>
    <div class="drawer-edge-controls">
      <button
        class="drawer-edge-toggle drawer-edge-toggle-left"
        type="button"
        data-drawer-toggle="config"
        aria-controls="editor-config-panel"
        aria-expanded="false"
      >
        <span class="drawer-toggle-glyph" aria-hidden="true">&lt;</span>
        <span>{t.drawerConfig}</span>
      </button>
      <button
        class="drawer-edge-toggle drawer-edge-toggle-right"
        type="button"
        data-drawer-toggle="templates"
        aria-controls="editor-templates-panel"
        aria-expanded="false"
      >
        <span>{t.drawerTemplates}</span>
        <span class="drawer-toggle-glyph" aria-hidden="true">&gt;</span>
      </button>
    </div>

    <div class="drawer-backdrop" data-drawer-backdrop hidden></div>

    <aside
      class="editor-rail rail-config"
      id="editor-config-panel"
      data-drawer-panel="config"
      aria-hidden="false"
    >
      <div class="rail-heading rail-heading-with-close">
        <div class="rail-heading-copy">
          <span class="eyebrow">{ui.configEyebrow}</span>
          <h3>{ui.configTitle}</h3>
        </div>
        <button
          class="drawer-close"
          type="button"
          data-drawer-close="config"
          aria-label={t.drawerClose}
        >
          <span class="drawer-close-glyph" aria-hidden="true">×</span>
          <span class="sr-only">{t.drawerClose}</span>
        </button>
      </div>

      <form id="signature-form">
        <input type="hidden" name="template" />

        <details class="config-section" open>
          <summary><span>1</span> {ui.personalSection}</summary>
          <div class="config-body field-grid">
            {
              personalFields.map((field) => (
                <label
                  class:list={{
                    wide:
                      field.name === "legalText" || field.name === "address",
                  }}
                  data-field-wrapper
                  data-field-name={field.name}
                  data-field-label={field.label}
                >
                  <span class="field-label-row">
                    <span class="field-label-text">{field.label}</span>
                    <small
                      class="field-support-note"
                      data-field-support-note={field.name}
                      title={t.fieldHidden}
                      hidden
                    >
                      {ui.supportCompact}
                    </small>
                  </span>
                  <input
                    name={field.name}
                    type={
                      field.name === "email"
                        ? "email"
                        : field.name === "website"
                          ? "url"
                          : "text"
                    }
                    inputmode={fieldInputMode[field.name]}
                    maxlength={fieldMaxLength[field.name]}
                    autocomplete={fieldAutocomplete[field.name]}
                    data-field-control
                    data-example-value={field.example}
                    data-validation-kind={fieldValidationKind[field.name]}
                    aria-describedby={`${field.name}-error`}
                  />
                  <small
                    id={`${field.name}-error`}
                    class="field-error"
                    data-field-error
                    hidden
                  />
                </label>
              ))
            }
          </div>
        </details>

        <details class="config-section">
          <summary><span>2</span> {ui.mediaSection}</summary>
          <div class="config-body">
            <label
              data-field-wrapper
              data-field-name="logoUrl"
              data-field-label={ui.logoUrlLabel}
            >
              <span class="field-label-row">
                <span class="field-label-text">{ui.logoUrlLabel}</span>
                <small
                  class="field-support-note"
                  data-field-support-note="logoUrl"
                  title={t.fieldHidden}
                  hidden
                >
                  {ui.supportCompact}
                </small>
              </span>
              <input name="logoUrl" type="url" data-field-control />
            </label>
            <label
              data-field-wrapper
              data-field-name="photoUrl"
              data-field-label={ui.photoUrlLabel}
            >
              <span class="field-label-row">
                <span class="field-label-text">{ui.photoUrlLabel}</span>
                <small
                  class="field-support-note"
                  data-field-support-note="photoUrl"
                  title={t.fieldHidden}
                  hidden
                >
                  {ui.supportCompact}
                </small>
              </span>
              <input name="photoUrl" type="url" data-field-control />
            </label>
            <label>
              {ui.localPreviewLabel}
              <input
                id="local-image"
                type="file"
                accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif"
              />
            </label>
            <p class="section-help">{ui.localImageHelp}</p>
            <div class="local-image-actions">
              <button
                id="open-local-image-tools"
                class="ghost-button"
                type="button"
              >
                {ui.localImageOpen}
              </button>
              <button
                id="remove-local-image"
                class="ghost-button danger"
                type="button"
                disabled
              >
                {ui.localImageRemove}
              </button>
            </div>
            <p id="local-warning" class="warning" hidden>{t.localWarning}</p>
          </div>
        </details>

        <details class="config-section" open>
          <summary><span>3</span> {ui.colorsSection}</summary>
          <div class="config-body appearance-grid">
            <label class="appearance-field">
              <span class="appearance-label">{ui.primaryColor}</span>
              <input name="primaryColor" type="color" />
            </label>
            <label class="appearance-field">
              <span class="appearance-label">{ui.secondaryColor}</span>
              <input name="secondaryColor" type="color" />
            </label>
            <label class="appearance-field">
              <span class="appearance-label">{ui.size}</span>
              <select name="size">
                <option value="compact">{ui.sizeCompact}</option>
                <option value="normal" selected>{ui.sizeNormal}</option>
                <option value="wide">{ui.sizeWide}</option>
              </select>
            </label>
            <div class="palette-presets">
              <p class="section-help">{ui.paletteHelp}</p>
              <div class="palette-list">
                {
                  palettePresets.map((palette) => (
                    <button
                      class="palette-chip"
                      type="button"
                      data-palette-primary={palette.primary}
                      data-palette-secondary={palette.secondary}
                    >
                      <span class="palette-dots">
                        <span style={`background:${palette.primary}`} />
                        <span style={`background:${palette.secondary}`} />
                      </span>
                      <span>
                        <strong>{palette.name}</strong>
                        <small>{palette.note}</small>
                      </span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </details>

        <details class="config-section" open>
          <summary><span>4</span> {ui.socialSection}</summary>
          <div class="config-body">
            <p class="section-help">{ui.socialHelp}</p>
            <div id="social-list" class="social-list"></div>
            <button id="add-social" class="add-social" type="button"
              >{ui.addSocial}</button
            >
          </div>
        </details>
      </form>
    </aside>

    <section class="preview-workspace">
      <div class="preview-heading">
        <div>
          <span class="eyebrow">{ui.previewEyebrow}</span>
          <h3>{t.preview}</h3>
          <p class="panel-copy">{t.previewNote}</p>
        </div>
        <div class="preview-switch">
          <button
            class="view-toggle active"
            type="button"
            data-preview-mode="desktop"
          >
            {ui.previewDesktop}
          </button>
          <button class="view-toggle" type="button" data-preview-mode="mobile">
            {ui.previewMobile}
          </button>
        </div>
      </div>

      <div class="preview-stage" id="preview-stage">
        <div class="preview-window" id="preview-window">
          <div class="preview-window-bar"></div>
          <div id="preview" class="preview"></div>
        </div>
      </div>

      <div class="mini-plan">
        <a class="mini-link-card" href={`/${locale}/`}>
          <strong>{t.mainFlowTitle}</strong>
          <p>{t.mainFlowCopy}</p>
        </a>
        <a class="mini-link-card" href="#saved-list">
          <strong>{t.savedFlowTitle}</strong>
          <p>{t.savedFlowCopy}</p>
        </a>
      </div>

      <div class="actions">
        <button id="copy">{t.copy}</button>
        <button id="download">{t.download}</button>
        <button id="export">{t.export}</button>
        <label class="button"
          >{t.import}<input
            id="import"
            type="file"
            accept=".json,application/json"
          /></label
        >
        <button id="save-library" class="secondary">{t.saveToLibrary}</button>
        <button id="clear" class="secondary">{t.clear}</button>
      </div>
      <p id="status" role="status" aria-live="polite">{t.saved}</p>
    </section>

    <aside
      class="editor-rail rail-library"
      id="editor-templates-panel"
      data-drawer-panel="templates"
      aria-hidden="false"
    >
      <div class="rail-heading rail-heading-with-close">
        <div class="rail-heading-copy">
          <span class="eyebrow">{ui.templatesEyebrow}</span>
          <h3>{ui.templatesTitle}</h3>
        </div>
        <button
          class="drawer-close"
          type="button"
          data-drawer-close="templates"
          aria-label={t.drawerClose}
        >
          <span class="drawer-close-glyph" aria-hidden="true">×</span>
          <span class="sr-only">{t.drawerClose}</span>
        </button>
      </div>
      <div class="template-showcase">
        {
          localizedTemplates.map((template) => (
            <button
              class="template-card"
              type="button"
              data-template={template.id}
            >
              <div class="template-thumb">
                <div
                  class="template-thumb-canvas"
                  data-template-preview={template.id}
                />
              </div>
              <strong>{template.cardTitle}</strong>
              <span>{template.note}</span>
            </button>
          ))
        }
      </div>
    </aside>
  </section>

  <section class="library-band">
    <div class="support-card support-card-wide">
      <div class="saved-library-heading">
        <div>
          <span class="eyebrow">{ui.libraryEyebrow}</span>
          <h3>{t.savedLibrary}</h3>
        </div>
        <a class="library-link" href={`/${locale}/saved-signatures/`}
          >{t.savedLibraryHint}</a
        >
      </div>
      <p class="support-copy">{t.savedPageCopy}</p>
      <div class="support-actions">
        <a class="support-pill" href={`/${locale}/saved-signatures/`}
          >{t.savedPageAction}</a
        >
      </div>
    </div>
  </section>

  <section class="support-band is-hidden" hidden aria-hidden="true">
    <div class="support-card support-card-wide">
      <div class="saved-library-heading">
        <div>
          <span class="eyebrow">{ui.supportEyebrow}</span>
          <h3>{t.supportTitle}</h3>
        </div>
        <a class="library-link" href={`/${locale}/support-open-source/`}
          >{t.supportLink}</a
        >
      </div>
      <p class="support-copy">{t.supportCopy}</p>
      <div class="support-actions support-actions-inline">
        <a
          class="support-pill"
          href="https://github.com/sponsors"
          target="_blank"
          rel="noreferrer">GitHub Sponsors</a
        >
        <a
          class="support-pill"
          href="https://opencollective.com/"
          target="_blank"
          rel="noreferrer">Open Collective</a
        >
        <a class="support-pill tertiary" href={`/${locale}/donations/`}
          >Donaciones</a
        >
      </div>
    </div>
  </section>

  <div
    class="image-tools-modal"
    id="local-image-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="local-image-modal-title"
    hidden
  >
    <div class="image-tools-backdrop" data-local-image-cancel></div>
    <section class="image-tools-panel">
      <div class="image-tools-header">
        <h3 id="local-image-modal-title">{ui.localImageModalTitle}</h3>
        <button
          class="drawer-close"
          type="button"
          data-local-image-cancel
          aria-label={ui.localImageCancel}
        >
          <span class="drawer-close-glyph" aria-hidden="true">×</span>
          <span class="sr-only">{ui.localImageCancel}</span>
        </button>
      </div>
      <canvas
        id="local-image-canvas"
        class="image-tools-canvas"
        width="384"
        height="384"></canvas>
      <div class="image-tools-controls">
        <label>
          {ui.localImageTarget}
          <select id="local-image-target">
            <option value="photoUrl">{ui.localImagePhoto}</option>
            <option value="logoUrl">{ui.localImageLogo}</option>
          </select>
        </label>
        <label>
          {ui.localImageMode}
          <select id="local-image-mode">
            <option value="cover">{ui.localImageCover}</option>
            <option value="contain">{ui.localImageContain}</option>
          </select>
        </label>
        <label>
          {ui.localImageFormat}
          <select id="local-image-format">
            <option value="image/webp">WebP</option>
            <option value="image/jpeg">JPG</option>
            <option value="image/png">PNG</option>
          </select>
        </label>
        <label>
          {ui.localImageZoom}
          <input
            id="local-image-zoom"
            type="range"
            min="1"
            max="2"
            step="0.01"
            value="1"
          />
        </label>
        <label>
          {ui.localImageHorizontal}
          <input
            id="local-image-x"
            type="range"
            min="-100"
            max="100"
            step="1"
            value="0"
          />
        </label>
        <label>
          {ui.localImageVertical}
          <input
            id="local-image-y"
            type="range"
            min="-100"
            max="100"
            step="1"
            value="0"
          />
        </label>
      </div>
      <div class="image-tools-actions">
        <button class="ghost-button" type="button" data-local-image-cancel>
          {ui.localImageCancel}
        </button>
        <button id="apply-local-image" type="button"
          >{ui.localImageApply}</button
        >
      </div>
    </section>
  </div>
</section>
<script>
  import "../scripts/editor";
</script>
