---
import {
  dictionary,
  localeNames,
  locales,
  type Locale,
} from "../i18n/dictionaries";
import "../styles/global.css";
interface Props { locale: Locale; title?: string; description?: string }
const { locale, title, description } = Astro.props;
const t = dictionary(locale);
const site = import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const canonical = new URL(Astro.url.pathname, site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title ?? t.title}</title>
    <meta name="description" content={description ?? t.promise} />
    <link rel="canonical" href={canonical} />
    {locales.map((item) => <link rel="alternate" hreflang={item} href={new URL(`/${item}${Astro.url.pathname.replace(/^\/[^/]+/, "")}`, site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/en/", site)} />
    <meta property="og:title" content={title ?? t.title} /><meta property="og:description" content={description ?? t.promise} /><meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <a class="brand" href={`/${locale}/`}>Email Signature Generator</a>
      <nav aria-label="Main navigation">
        <a href={`/${locale}/email-installation-guide/`}>{t.guide}</a><a href={`/${locale}/email-signature-templates/`}>{t.templates}</a><a href={`/${locale}/faq/`}>{t.faq}</a><a href={`/${locale}/saved-signatures/`}>{t.savedLibrary}</a>
      </nav>
      <label class="language">{t.language} <select id="language">{locales.map((item) => <option value={item} selected={item === locale}>{localeNames[item]}</option>)}</select></label>
    </header>
    <main id="content"><slot /></main>
    <footer><a href={`/${locale}/privacy/`}>{t.privacyPage}</a> · <a href="https://github.com/anderson-camacho/email-signature-generator">Repository</a> · <a href="/LICENSE">MPL-2.0</a></footer>
    <script is:inline>
      document.querySelector("#language")?.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement)) return;
        const locale = target.value;
        localStorage.setItem("email-signature-generator:locale", locale);
        location.href = `/${locale}${location.pathname.replace(/^\/[^/]+/, "")}`;
      });
    </script>
  </body>
</html>
