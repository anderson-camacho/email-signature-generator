---
import {
  dictionary,
  localeNames,
  locales,
  type Locale,
} from "../i18n/dictionaries";
import "../styles/global.css";
interface Props { locale: Locale; title?: string; description?: string }
const { locale, title, description } = Astro.props;
const t = dictionary(locale);
const site = import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const canonical = new URL(Astro.url.pathname, site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title ?? t.title}</title>
    <meta name="description" content={description ?? t.promise} />
    <link rel="canonical" href={canonical} />
    {locales.map((item) => <link rel="alternate" hreflang={item} href={new URL(`/${item}${Astro.url.pathname.replace(/^\/[^/]+/, "")}`, site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/en/", site)} />
    <meta property="og:title" content={title ?? t.title} /><meta property="og:description" content={description ?? t.promise} /><meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-shell">
        <a class="brand" href={`/${locale}/`}>
          <span class="brand-mark">ES</span>
          <span class="brand-copy">
            <strong>Email Signature Generator</strong>
            <small>Fast editor, local library, multilingual setup</small>
          </span>
        </a>
        <div class="header-controls">
          <nav aria-label="Main navigation" class="main-nav">
            <a href={`/${locale}/email-installation-guide/`}>{t.guide}</a>
            <a href={`/${locale}/faq/`}>{t.faq}</a>
            <a href={`/${locale}/saved-signatures/`}>{t.savedLibrary}</a>
          </nav>
          <div class="header-donate-shell">
            <div id="header-donate-button-container" class="header-donate-button-container">
              <div id="header-donate-button"></div>
            </div>
          </div>
          <label class="language-picker" aria-label={t.language}>
            <select id="language">
              {locales.map((item) => <option value={item} selected={item === locale}>{localeNames[item]}</option>)}
            </select>
          </label>
        </div>
      </div>
    </header>
    <main id="content"><slot /></main>
    <div
      id="donation-feedback"
      class="donation-feedback"
      role="status"
      aria-live="polite"
      hidden
    >
      <strong>{t.donationThanksTitle}</strong>
      <p>{t.donationThanksCopy}</p>
    </div>
    <footer><a href={`/${locale}/privacy/`}>{t.privacyPage}</a> · <a href="https://github.com/anderson-camacho/email-signature-generator">Repository</a> · <a href="/LICENSE">MPL-2.0</a></footer>
    <script src="https://www.paypalobjects.com/donate/sdk/donate-sdk.js" charset="UTF-8"></script>
    <script is:inline define:vars={{ donationThanksTitle: t.donationThanksTitle, donationThanksCopy: t.donationThanksCopy }}>
      document.querySelector("#language")?.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement)) return;
        const locale = target.value;
        localStorage.setItem("email-signature-generator:locale", locale);
        location.href = `/${locale}${location.pathname.replace(/^\/[^/]+/, "")}`;
      });

      const footer = document.querySelector("footer");
      const licenseLink = footer?.querySelector('a[href="/LICENSE"]');
      if (
        footer instanceof HTMLElement &&
        licenseLink instanceof HTMLAnchorElement &&
        !footer.querySelector('[data-creator-link="true"]')
      ) {
        footer.insertBefore(document.createTextNode(" · "), licenseLink);

        const creatorLink = document.createElement("a");
        creatorLink.href = "https://github.com/anderson-camacho";
        creatorLink.textContent = "Creador";
        creatorLink.dataset.creatorLink = "true";

        footer.insertBefore(creatorLink, licenseLink);
      }

      let donationFeedbackTimeout;

      const showDonationFeedback = () => {
        const feedback = document.querySelector("#donation-feedback");
        if (!(feedback instanceof HTMLElement)) return;

        feedback.hidden = false;
        feedback.classList.add("is-visible");
        feedback.querySelector("strong")?.replaceChildren(donationThanksTitle);
        feedback.querySelector("p")?.replaceChildren(donationThanksCopy);

        window.clearTimeout(donationFeedbackTimeout);
        donationFeedbackTimeout = window.setTimeout(() => {
          feedback.classList.remove("is-visible");
          window.setTimeout(() => {
            feedback.hidden = true;
          }, 220);
        }, 5200);
      };

      const renderPaypalDonateButton = () => {
        const container = document.querySelector("#header-donate-button");
        if (!(container instanceof HTMLElement) || container.dataset.rendered === "true") return;
        if (!window.PayPal?.Donation?.Button) return;

        container.dataset.rendered = "true";
        window.PayPal.Donation.Button({
          env: "production",
          hosted_button_id: "9HLNFUZS5DJ72",
          image: {
            src: "https://www.paypalobjects.com/en_US/i/btn/btn_donate_LG.gif",
            alt: "Donate with PayPal button",
            title: "PayPal - The safer, easier way to pay online!",
          },
          onComplete: function () {
            showDonationFeedback();
          },
        }).render("#header-donate-button");
      };

      const waitForPaypalDonateButton = () => {
        if (window.PayPal?.Donation?.Button) {
          renderPaypalDonateButton();
          return;
        }

        window.setTimeout(waitForPaypalDonateButton, 120);
      };

      waitForPaypalDonateButton();
    </script>
  </body>
</html>
